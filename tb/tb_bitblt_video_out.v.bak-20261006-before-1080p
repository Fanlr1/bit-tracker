// Testbench for bitblt_video_out.
//
// WHAT IS CHECKED
//   1. AXI read address  == fb_base + row * fb_stride, one burst per line
//   2. rd_row wraps at fb_height
//   3. pixel order: ascending within a line, correct across line boundaries
//   4. de/rgb phase -- rgb must carry the pixel de marks, on the same cycle
//
// The AXI slave returns an identifiable value per pixel:
//     pixel(row, col) = row*1000 + col
// so an ordering mistake shows up as a wrong colour rather than merely "some
// data arrived".
//
// TESTBENCH PITFALLS DELIBERATELY AVOIDED (learned earlier in this project):
//   * rlast and rdata are COMBINATIONAL with respect to the beat being presented.
//     Registering rlast makes the first beat of a burst look like the last one;
//     registering rdata makes beat 0 appear twice.
//   * stimulus is applied #1 after the clock edge, never in the same timestep.
`timescale 1ns / 1ps

module tb_bitblt_video_out;

    // ---------------- clocks ----------------
    reg clk  = 1'b0;      // AXI domain, 100 MHz
    reg pclk = 1'b0;      // pixel domain, 25 MHz
    always #5  clk  = ~clk;
    always #20 pclk = ~pclk;

    reg rst_n = 1'b0;

    // ---------------- configuration ----------------
    localparam H_ACT = 640, V_ACT = 480;
    localparam FB_W  = 640;
    localparam FB_H  = 480;
    localparam STRIDE = 4096;                  // 4 KB-aligned pitch -- see docs/40
    localparam BASE   = 32'h8000_0000;
    localparam BEATS  = FB_W / 4;              // 160 beats per line

    reg [31:0] fb_base   = BASE;
    reg [15:0] fb_stride = STRIDE;
    reg [15:0] fb_width  = FB_W;
    reg [15:0] fb_height = FB_H;
    reg        enable    = 1'b0;

    // fb_stride is overridable so ONE testbench can demonstrate BOTH sides of
    // the 4 KB question -- a positive and a negative case from the same code:
    //
    //   +stride=2560   the old natural pitch  -> bursts cross 4 KB -> FAIL
    //   +stride=4096   the 4 KB-aligned pitch -> no crossing       -> PASS
    //
    // Without the negative case the assertion could be vacuous: a check that
    // never fires proves nothing. $value$plusargs is used rather than
    // $test$plusargs because the latter does PREFIX matching, so "+stride"
    // would also be matched by an unrelated "+stride_foo".
    integer stride_arg = 0;
    initial begin
        if ($value$plusargs("stride=%d", stride_arg))
            fb_stride = stride_arg[15:0];
    end

    // ---------------- AXI4 read slave BFM ----------------
    wire [7:0]   arid;
    wire [31:0]  araddr;
    wire [7:0]   arlen;
    wire [2:0]   arsize;
    wire [1:0]   arburst;
    wire         arvalid;
    reg          arready = 1'b1;

    reg  [7:0]   rid    = 8'h20;
    reg  [127:0] rdata;
    reg  [1:0]   rresp  = 2'b00;
    reg          rlast;
    reg          rvalid = 1'b0;
    wire         rready;

    // ---- build one beat from (row, beat index) ----
    // beat contains pixels col = 4*b .. 4*b+3, each 32-bit {A,R,G,B} with RGB low
    // The arithmetic goes through an explicit reg first: Verilog rejects a
    // concatenation operand whose width is not self-determined, which is what
    // {8'hFF, (row*1000+col)} would be.
    function [31:0] pix;
        input [31:0] row;
        input [31:0] col;
        reg   [31:0] v;
        begin
            v   = row*1000 + col;
            pix = {8'hFF, v[23:0]};
        end
    endfunction

    function [127:0] beat_data;
        input [31:0] row;
        input [31:0] b;
        begin
            beat_data = { pix(row, b*4 + 3), pix(row, b*4 + 2),
                          pix(row, b*4 + 1), pix(row, b*4 + 0) };
        end
    endfunction

    // ---- burst engine ----
    reg [31:0] cur_row  = 32'd0;
    reg [31:0] beat_idx = 32'd0;
    reg        bursting = 1'b0;
    integer    ar_count = 0;

    // capture AR and derive which row it refers to
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            bursting <= 1'b0;
            beat_idx <= 32'd0;
            cur_row  <= 32'd0;
            rvalid   <= 1'b0;
            ar_count <= 0;
        end else begin
            if (arvalid && arready) begin
                cur_row  <= (araddr - fb_base) / fb_stride;
                ar_count <= ar_count + 1;
                beat_idx <= 32'd0;
                bursting <= 1'b1;
                rvalid   <= 1'b1;
            end else if (bursting) begin
                if (rvalid && rready) begin
                    if (rlast) begin
                        bursting <= 1'b0;
                        rvalid   <= 1'b0;
                        beat_idx <= 32'd0;
                    end else begin
                        beat_idx <= beat_idx + 32'd1;
                    end
                end
            end
        end
    end

    // rdata / rlast are COMBINATIONAL w.r.t. the beat being presented
    always @(*) begin
        rdata = beat_data(cur_row, beat_idx);
        rlast = (beat_idx == BEATS - 1);
    end

    // ---------------- DUT ----------------
    wire [23:0] rgb;
    wire        de, hs, vs;
    wire [15:0] h_cnt_o, v_cnt_o;
    wire        cfg_error;

    bitblt_video_out #(
        .H_ACT  (H_ACT),
        .V_ACT  (V_ACT),
        .AXI_ID (8'h20)
    ) dut (
        .clk          (clk),
        .rst_n        (rst_n),
        .pclk         (pclk),
        .fb_base      (fb_base),
        .fb_stride    (fb_stride),
        .fb_width     (fb_width),
        .fb_height    (fb_height),
        .enable       (enable),
        .m_axi_arid   (arid),
        .m_axi_araddr (araddr),
        .m_axi_arlen  (arlen),
        .m_axi_arsize (arsize),
        .m_axi_arburst(arburst),
        .m_axi_arvalid(arvalid),
        .m_axi_arready(arready),
        .m_axi_rid    (rid),
        .m_axi_rdata  (rdata),
        .m_axi_rresp  (rresp),
        .m_axi_rlast  (rlast),
        .m_axi_rvalid (rvalid),
        .m_axi_rready (rready),
        .rgb          (rgb),
        .de           (de),
        .hs           (hs),
        .vs           (vs),
        .h_cnt_o      (h_cnt_o),
        .v_cnt_o      (v_cnt_o),
        .cfg_error    (cfg_error)
    );

    // ---------------- checking ----------------
    integer errors   = 0;
    integer checks   = 0;
    integer exp_row  = 0;
    integer exp_col  = 0;
    reg     de_d     = 1'b0;
    integer lines_seen = 0;

    // ---------------- AXI4 4 KB boundary check ----------------
    // AXI4 forbids a burst from crossing a 4 KB boundary, and the DDR3
    // controller does NOT split one that does: its user guide documents only
    // axi_alen / axi_asize / axi_aburst pass-through, with no promise to
    // handle a crossing (see docs/40, and docs/21 item 1).
    //
    // This is the only place in the project where that property can be checked
    // without a board, so it is asserted here rather than left to a bring-up
    // experiment.
    //
    // The arithmetic, per burst:
    //     start offset within its 4 KB page = araddr[11:0]
    //     bytes transferred                 = (arlen + 1) * 16   (128-bit beats)
    //     must satisfy  start + bytes <= 4096
    //
    // With fb_stride = 4096 and a 640-pixel row (2560 bytes) every row starts
    // 4 KB-aligned, so no burst can reach the next boundary. With the old
    // stride of 2560 this check fails on rows 2, 3, 6, 7, ...
    integer ar_seen     = 0;
    integer ar_crossing = 0;
    integer ar_aligned  = 0;
    integer burst_bytes;

    always @(posedge clk) begin
        if (rst_n && arvalid && arready) begin
            burst_bytes = (arlen + 1) * 16;
            ar_seen = ar_seen + 1;
            if (araddr[11:0] == 0)
                ar_aligned = ar_aligned + 1;
            if ((araddr[11:0] + burst_bytes) > 4096) begin
                ar_crossing = ar_crossing + 1;
                if (ar_crossing <= 5)
                    $display("  4KB CROSS t=%0t addr=%h off=%0d len=%0d bytes=%0d end=%0d",
                             $time, araddr, araddr[11:0], arlen, burst_bytes,
                             araddr[11:0] + burst_bytes);
            end
        end
    end

    always @(posedge pclk) begin
        if (rst_n) begin
            de_d <= de;

            if (de) begin
                checks = checks + 1;
                if (rgb !== (exp_row*1000 + exp_col)) begin
                    if (errors < 10)
                        $display("  MISMATCH t=%0t row=%0d col=%0d got=%0d exp=%0d",
                                 $time, exp_row, exp_col, rgb, exp_row*1000 + exp_col);
                    errors = errors + 1;
                end

                if (exp_col == FB_W - 1) begin
                    exp_col = 0;
                    exp_row = exp_row + 1;
                    lines_seen = lines_seen + 1;
                end else begin
                    exp_col = exp_col + 1;
                end
            end
        end
    end

    // ---------------- stimulus ----------------
    integer i;
    initial begin
        $dumpfile("tb_bitblt_video_out.vcd");
        $dumpvars(0, tb_bitblt_video_out);

        repeat (10) @(posedge clk);
        @(negedge clk); rst_n = 1'b1;
        repeat (10) @(posedge clk);

        @(negedge clk); enable = 1'b1;

        // let it run long enough for a few complete lines
        repeat (120000) @(posedge pclk);

        $display("");
        $display("==================================================");
        $display("  checks       = %0d", checks);
        $display("  errors       = %0d", errors);
        $display("  lines seen   = %0d", lines_seen);
        $display("  AR bursts    = %0d", ar_count);
        $display("  first AR addr= 0x%08h  (expect 0x%08h)", BASE, BASE);
        $display("  ---- AXI4 4KB boundary ----");
        $display("  AR seen      = %0d", ar_seen);
        $display("  AR 4K-aligned= %0d   (araddr[11:0] == 0)", ar_aligned);
        $display("  AR crossing  = %0d   (MUST be 0)", ar_crossing);
        $display("==================================================");

        // ar_crossing is part of the verdict, not just a printed statistic:
        // a burst that crosses 4 KB violates AXI4 and the controller is not
        // documented to survive it.
        if (errors == 0 && ar_crossing == 0 && ar_seen > 0 && checks > 1000 && ar_count > 0)
            $display("RESULT: PASS");
        else
            $display("RESULT: FAIL");

        $finish;
    end

    // timeout guard
    initial begin
        #5_000_000;
        $display("RESULT: FAIL (timeout)");
        $finish;
    end

endmodule
