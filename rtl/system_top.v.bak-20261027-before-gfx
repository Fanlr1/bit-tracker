// 2026-10-14: scan-out self-proof. Both cross pclk -> clk with the same
// stable-sample scheme as short_count. They change once per FRAME (1.67M cycles
// apart at 60 Hz), so "accept when two consecutive samples agree" always finds
// a settled value -- unlike short_count, which moves continuously.
wire [15:0]      vid_lines_last;         // pclk domain
