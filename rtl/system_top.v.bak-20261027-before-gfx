// ==========================================================================
// R-CHANNEL WATCHDOG (2026-10-17) -- the fix for the board's "slow state"
//
// SYMPTOM. On most power-ups the board enters a permanent slow state where every
// sprite fetch costs ~13.75 M cycles instead of ~1,460 (hw=440,002,xxx for the
// 8-frame animation instead of ~3,700). fill is unaffected.
//
// MECHANISM (measured; the GPIO probe at line ~797 reads r_cnl=0, rd0_rr=0,
// rd1_rr=0 in a slow run, and the notes at line ~786 record the rest):
//   1. A read is issued and Axi_Mux forwards its AR to the DDR controller.
//   2. The controller is IN-ORDER: it owes the R data for that read before it
//      accepts any further AR.
//   3. The R data arrives but the SoC channel does not take it (rready = 0).
//      AXI forbids dropping the data, so the controller waits -- indefinitely.
//   4. Both bitblt read engines now wait forever for an AR that is never
//      accepted; every sprite fetch hits the 65,535-cycle handshake timeout.
//
// docs/63 and docs/68 closed two other routes into step 3 (burst admission on
// the read engines, and on scan-out). This one is on the SoC's channel, which is
// vendor IP and cannot be modified -- but it does not have to be, because the
// deadlock only persists while NOTHING consumes that data.
//
// WHAT THIS DOES. If the SoC channel refuses presented R data for 10 ms, the
// ready seen by Axi_Mux is forced high: the burst completes, the mux's info FIFO
// pops, and the in-order controller moves on. The engines recover immediately.
//
// COST. The SoC misses that one burst. A SoC that missed a read is strictly
// better than a SoC (and an engine) that is wedged forever, and 10 ms is far
// longer than any legitimate backpressure here -- scan-out alone consumes a line
// every ~14.8 us, and the whole sprite read path completes in ~1,460 cycles.
// ==========================================================================
localparam [27:0] SOC_R_HANG_LIMIT = 28'd1_000_000;      // 10 ms at 100 MHz
reg [27:0] soc_r_hang;
always @(posedge user_clk or negedge sys_rst) begin
    if (!sys_rst)                                  soc_r_hang <= 28'd0;
    else if (soc_ddrA_rvalid && !soc_ddrA_rready)  soc_r_hang <= (soc_r_hang == SOC_R_HANG_LIMIT)
                                                                 ? soc_r_hang : soc_r_hang + 28'd1;
    else                                           soc_r_hang <= 28'd0;
end
wire soc_r_forced        = (soc_r_hang == SOC_R_HANG_LIMIT);
wire soc_ddrA_rready_eff = soc_ddrA_rready | soc_r_forced;

// ==========================================================================
// DEBUG OBSERVATION MUX (2026-10-17) -- an observation point that DISCRIMINATES
//
// The probe added earlier tonight ({r_cnl_num, rd1_rready, rd0_rready}) read 0x0
// in BOTH the slow and the normal state, so it could not tell them apart and any
// conclusion drawn from it was unfounded. This mux exposes the handshake pairs
// that actually decide the outcome, one 4-bit group at a time.
//
// Software writes GPIO output bits [1:0] to select, then reads GPIO input:
//   sel 0: {s_axi_arready,  s_axi_arvalid,  s_axi_rready,  s_axi_rvalid}  (DDR side)
//   sel 1: {soc_ddrA_arready, soc_ddrA_arvalid,
//           soc_ddrA_rready,  soc_ddrA_rvalid}                          (SoC side)
//   sel 2: {s_axi_awready,  s_axi_awvalid,  s_axi_wready,  s_axi_wvalid} (DDR write side)
//   sel 3: {soc_r_forced,   s_axi_bready,   s_axi_bvalid,  1'b0}         (watchdog + B)
//
// sel 0 vs sel 1 is the decisive comparison: if the mux holds arvalid high while
// the DDR controller holds arready low, the controller is refusing; if the SoC
// side shows rvalid high with rready low, a channel is not taking its data.
// ==========================================================================
// Moved up from the Axi_Mux instantiation: the observation mux needs these.
// ar_cnl_num is the value Axi_Mux_Addr_Ctrl latched when it granted the AR bus;
// if it stops changing while a channel still asserts ARVALID, the arbiter is
// stuck holding that channel (the 2026-10-13 hypothesis, never yet observed).
wire [2:0] ar_cnl_num;
wire [2:0] r_cnl_num;
wire [1:0] obs_sel = soc_gpio_OUT[1:0];
reg  [3:0] obs_val;
always @(*) begin
    case (obs_sel)
        // 2026-10-25 sel0: the SCAN-OUT LINE SEGMENT (v_cnt[11:8]).
        // Paired with sel1 (rd_row[11:8]) this is the whole test: v_cnt must walk
        // 0..4 once per frame (1125 lines), and rd_row must walk the same span in
        // step with it. If rd_row runs past 4 the scan-out is reading memory past
        // the framebuffer, which is exactly what puts stale content on screen.
        2'd0:    obs_val = vid_v_cnt[11:8];
        // sel1: the ENGINE side of the AR handshake, to pair with sel0 (DDR side).
        // {bl1_arvalid, bl1_arready, bl2_arvalid, bl2_arready} -- rd0 = source read
        // (mux S1), rd1 = destination read (mux S2). If a slow run shows
        // bl1_arvalid=1 while sel0 shows s_axi_arvalid=0, the mux is not
        // forwarding a request that is definitely being made.
        // sel1 (2026-10-17): WHICH CHANNEL OWNS THE R BUS.
        // The AR side already proved healthy (ARs rotate between the engines), and
        // orphan absorption did NOT fix the slow state -- so R_Act_Cnl_List is not
        // zero; the mux is holding R data for a channel whose rready is low.
        // This says which one: 0 = SoC, 1 = rd0 source, 2 = rd1 destination.
        // {r_cnl_num[2:0], 1'b0}
        // sel1 (2026-10-17): in-flight read bookkeeping, docs/90 判据 A.
        //   bit3 = sticky "in-flight exceeded 16"
        //   bits2..0 = r_cnl_num (which channel the R bus is routed to right now)
        // If bit3 is set during a slow run, AR completions and R-burst completions
        // have drifted apart -- the info FIFO that routes R is out of step.
        // 2026-10-25: rd_row[11:8] -- the 256-line segment the AXI side is
        // fetching. Healthy: it walks 0,1,2,3,4 once per frame in step with the
        // scan. If it parks or jumps, the framebuffer row is no longer tied to the
        // screen row, which is exactly the 'same screen regions keep old content'
        // symptom.
        2'd1:    obs_val = vid_rd_row[11:8];
        // sel2: the two read-engine FSMs  {rd_src.state, rd_dst.state}
        // IDLE=0 AR=1 RD=2 DONE=3. A slow run showing both engines parked in
        // the same state names the wait that never completes.
        2'd2:    obs_val = dbg_rd_state;
        // sel3: the pixel path itself -- what the engines actually have.
        // {px_in_ready, px_in_valid, rd_dst_valid, rd_src_valid}. If a slow run
        // shows rd_src_valid=1 with rd_dst_valid=0, the destination reader is
        // starved and the pixel engine will not consume either FIFO.
        // sel3 (2026-10-17): THE AR ARBITRATION STATE -- the observation point
        // Axi_Mux_04 was built for in 2026-10-13 and never wired up.
        //   bit0 = Sta_Cnl_Switch  bit1 = Act_Cnl_Hit
        //   bit2 = Cnl_Search_En   bit3 = M_A_End
        // A healthy arbiter cycles through these; a stuck one parks in ACT with
        // no hit and no end.
        // sel3 (2026-10-17): the four busy bits of the top-level engine, so the
        // timeout snapshot carries them together with sel2's read-engine FSMs.
        //   bit0 = addr_busy  bit1 = rd_src_busy  bit2 = rd_dst_busy  bit3 = wr_busy
        // sel3 (2026-10-17): THE AR CONTENTION -- scan-out (S4) versus the CPU (S0).
        // The 2026-10-13 note in this file records this exact starvation mechanism
        // under priority arbitration: a master that polls continuously starves the
        // DMA channels. Arbitration is round-robin now, yet scan-out is still starved
        // by 8.6e8 pixel clocks and completes only ~10.6 frames/s -- so the question
        // is whether scan-out is asking for the bus at all, and whether the arbiter
        // answers when it does.
        //   bit0 = vid_arvalid       bit1 = vid_arready
        //   bit2 = soc_ddrA_arvalid  bit3 = soc_ddrA_arready
        // sel3 (2026-10-17, second revision): THE R SIDE. The AR side showed no
        // contention worth chasing, and the monitor reports NO handshake timeout in
        // a slow run while both read engines sit IDLE 32/32 -- so the 3.7 M cycles
        // per blit are spent waiting on the CPU's own register reads (~1,865 cycles
        // each against ~10 normally). That points at the R channel: whoever holds it
        // decides how long everyone else waits. r_cnl_num reads 4 (scan-out), and the
        // DDR side shows rready=0, i.e. nobody is accepting the data it has.
        //   bit0 = vid_rvalid      bit1 = vid_rready      (scan-out)
        //   bit2 = soc_ddrA_rvalid bit3 = soc_ddrA_rready (CPU)
        // sel3 (2026-10-17): THE AR ARBITRATION STATE, now that the picture is
        // clear. Four runs agree: hw=3.813 M (+-0.01%), to=444 every time, both read
        // engines driving ARVALID (eng=0x8) while the DDR side sees arvalid=0 with
        // arready=1. So the mux is not forwarding requests it can definitely see.
        // The 1024-cycle release added earlier only fires in S_ADDR_ACT; if the
        // arbiter is IDLE it never triggers, which would explain why that fix did
        // nothing. These four bits say which state it is actually in.
        //   bit0 = Sta_Cnl_Switch  bit1 = Act_Cnl_Hit
        //   bit2 = Cnl_Search_En   bit3 = M_A_End
        // sel3 (2026-10-17): the pixel path again, now that the AR arbiter reads
        // IDLE with no request pending -- the wait is upstream of the bus.
        //   bit0 = rd_src_valid  bit1 = rd_dst_valid
        //   bit2 = px_in_valid   bit3 = px_in_ready
        default: obs_val = dbg_observ;
    endcase
end



// ==== SoC POWER-ON RESET (added 2026-10-12) =================================
// The Sapphire SoC derives its internal system reset (systemCd_logic_outputReset)
// from io_asyncReset, passed through an async-assert / sync-deassert cell. That
// cell needs a *falling edge* on io_asyncReset to emit a reset pulse.
//
// io_asyncReset used to be wired straight to !pll_locked. If the PLLs are
// already locked by the time the FPGA finishes configuring, that signal is 0
// from the very first clock and the pulse never happens -- so every peripheral
// register keeps its power-up value.
//
// Measured symptom (2026-10-12): UART CLOCK_DIVIDER read back 0x00000000 even
// though soc.v programs 0x0000006B on reset, and no APB peripheral could be
// written (UART / SPI / GPIO / CLINT all read back 0, while RAM writes were
// perfect). Holding io_asyncReset high for 65536 user_clk cycles after
// configuration guarantees the SoC always sees one clean reset pulse.
reg [15:0] soc_por_cnt = 16'h0000;

always @(posedge user_clk) begin
    if (soc_por_cnt != 16'hFFFF)
        soc_por_cnt <= soc_por_cnt + 16'd1;
end

wire soc_por_done  = (soc_por_cnt == 16'hFFFF);

// ==========================================================================
// 2026-10-26: THE SoC MUST NOT START BEFORE DDR3 CALIBRATION COMPLETES.
// ==========================================================================
// soc_por_done releases after 65,535 cycles (~0.65 ms at 100 MHz) while DDR3
// calibration takes several milliseconds, and cal_done -- the controller's own
// "calibrated" output -- was declared and connected but NEVER USED.
//
// The consequence is exactly what the board shows: the application image in
// SPI flash is byte-for-byte correct (verified by reading it back), the
// bootloader runs (it is the same code that works under a JTAG configuration),
// yet the CPU never executes anything -- because the bootloader copies the
// application into DDR through a controller that is not ready yet, so the code
// lands nowhere.
//
// The decisive cross-check: loading the SAME image with openocd, seconds after
// configuration (i.e. with DDR long since calibrated), runs perfectly. The only
// difference between the two paths is WHEN the first DDR write happens.
//
// cal_done is latched (it may be a pulse) and a 24-bit timeout (~167 ms) is
// ORed in, so a failed calibration cannot hold the SoC in reset forever.
// 2026-10-26 (v2): A FIXED DELAY, NOT cal_done.
// v1 gated the SoC on cal_done; the board then failed to start at all, and the
// polarity/semantics of that controller output cannot be confirmed from the
// encrypted IP (it may mean "calibration in progress", not "done"). A fixed
// delay that comfortably exceeds DDR3 calibration time is unambiguous:
//   POR  65,535 cycles  (0.65 ms)   -- unchanged, covers PLL lock
//   EXT 21'h1F_FFFF     (20.97 ms @100 MHz) -- covers DDR3 calibration
// Both must elapse before the SoC leaves reset, so the bootloader's very first
// DDR write always lands in a live controller.
// ddr_cal_ok is still latched for observability but is deliberately NOT in the
// reset term.
reg        ddr_cal_ok;
reg [23:0] por_ext;
// 2026-10-26 (v3): 20 ms was still not enough. Symptom that forced this: the
// board runs the OLD application even though flash holds the new one, i.e. the
// bootloader's copy into DDR 0x1000 silently failed and the CPU executed
// whatever DDR still held. DDR3 calibration on this part can take tens of ms
// depending on temperature; 24 bits = 16.7 M cycles = 167 ms at 100 MHz, a
// deliberate over-estimate. It is paid once per power-up.
wire       por_ext_full = (por_ext == 24'hFFFFFF);

always @(posedge user_clk or negedge sys_rst) begin
    if (!sys_rst) begin
        ddr_cal_ok <= 1'b0;
        por_ext    <= 24'd0;
    end else begin
        if (cal_done)       ddr_cal_ok <= 1'b1;   // latched for observability only
        if (!por_ext_full)  por_ext    <= por_ext + 24'd1;
    end
end

wire soc_async_rst = ~(soc_por_done & pll_locked & user_pll_locked & por_ext_full);

// ==== DIAGNOSTIC LED (added 2026-10-12) =====================================
// Clock/reset health onto the four unused board LEDs (LED4..LED7).
// Read it as:  LED7=pll_locked  LED6=user_pll_locked  LED5=sys_rst  LED4=ddr_rstn
// All four must be steadily ON (1) in a healthy design. A blinking or dark LED
// means that clock/reset is unstable -> nothing downstream can ever run.
assign dbg_led = { pll_locked, user_pll_locked, sys_rst, ddr_rstn };

