// ==========================================================================
// Video output -- colour-bar bring-up mode
// ==========================================================================
// This revision drives TEST_MODE=2'b10 (built-in colour bar) so the HDMI path
// can be proven without depending on the frame-buffer read path. Swapping in
// bitblt_video_out (pixel-clock domain FIFO + line buffer) is the next step and
// touches only this block.
//
// 640x480@60 CEA-861 timing, taken from lcd_para.v -- the only reference in the
// demo set that uses standard parameters.
// ==========================================================================
// ==========================================================================
// Video scan-out -- reads the framebuffer over AXI4 (Axi_Mux slave port 4)
// ==========================================================================
// This replaces the colour-bar generator that was here for bring-up. The whole
// point of this revision is that the pixels now come from DDR3, so whatever the
// BitBlt engines write into the framebuffer is what appears on screen.
//
// The five configuration inputs are tied to constants for now rather than being
// driven from registers, on purpose: the open question at this stage is whether
// the datapath can fetch and display correctly at all, not whether the address
// is runtime-configurable. Wiring up registers first would mean debugging two
// things at once. They move into the register file once the path is proven.
//
// fb_base = 0x08000000 (128 MB into a 256 MB part): well clear of the low
// addresses where the SoC's code and data live.
//
// fb_stride comes from FB_CFG at runtime; the driver programmes 1920*4 = 7680.
// ==========================================================================
bitblt_video_out #(
    // 2026-10-14 FIX -- H_ACT/V_ACT were overridden here with 640/480, left over
    // from the 640x480 bring-up, while the driver programmes a 1920x1080
    // framebuffer and pix_clk runs at 148.5 MHz. The arithmetic:
    //     H_TOTAL = 640+88+44+148 = 920,  V_TOTAL = 525
    //     148.5e6 / (920 * 525) = 307 Hz
    // which no HDMI sink will display. commit 126585b fixed exactly this, and
    // the override came back in an uncommitted edit -- hence the second note.
    //
    // The module DEFAULTS (1920x1080 active, 2200x1125 total @ 148.5 MHz =
    // 59.94 Hz) ARE the product configuration. Do not re-add the override.
    .FIFO_AW (11),
    .AXI_ID  (8'h1E)              // low 4 bits: 8/A/C/E for us, 0-7 left to the SoC
) u_video_out (
    .clk           (user_clk),    // AXI domain, 100 MHz
    .rst_n         (ddr_rstn),
    .pclk          (pix_clk),     // pixel domain, 25 MHz

    .fb_base       (vid_fb_base),
    .fb_stride     (vid_fb_stride),
    .fb_width      (vid_fb_width),
    .fb_height     (vid_fb_height),
    .enable        (vid_fb_enable),

    .m_axi_arid    (vid_arid),
    .m_axi_araddr  (vid_araddr),
    .m_axi_arlen   (vid_arlen),
    .m_axi_arsize  (vid_arsize),
    .m_axi_arburst (vid_arburst),
    .m_axi_arvalid (vid_arvalid),
    .m_axi_arready (vid_arready),
    .m_axi_rid     (vid_rid),
    .m_axi_rdata   (vid_rdata),
    .m_axi_rresp   (vid_rresp),
    .m_axi_rlast   (vid_rlast),
    .m_axi_rvalid  (vid_rvalid),
    .m_axi_rready  (vid_rready),

    .rgb           (vid_rgb),
    .de            (vid_de),
    .hs            (vid_hs),
    .vs            (vid_vs),
    .h_cnt_o       (),
    .v_cnt_o       (vid_v_cnt),
    .rd_row_o      (vid_rd_row),
    .o_blanking    (vid_blanking),
    .o_short_sticky(vid_short),
    .o_short_count (vid_short_count),
    .o_lines_last  (vid_lines_last),
    .o_frames      (vid_frames),
    .o_underruns   (vid_underruns),
    .o_shown       (vid_shown),
    .o_axi_errors  (vid_axi_errors),
    // Raised when fb_width cannot be served by one AXI burst (not a multiple of
    // 4 pixels, or wider than 1024 so arlen would not fit its 8-bit field).
    // Wired rather than left open, and watched directly in simulation.
    .cfg_error     (vid_cfg_error)
);

// Two-flop synchroniser for the blanking bit. rst_n here is the AXI-domain
// reset (ddr_rstn), matching the clock these flops run on.
always @(posedge user_clk or negedge ddr_rstn) begin
    if (!ddr_rstn) begin
        scan_blanking_meta <= 1'b1;      // start "blanking" so nothing enables early
        scan_blanking      <= 1'b1;
        scan_short_meta    <= 1'b0;
        scan_short         <= 1'b0;
        short_s0           <= 32'd0;
        short_s1           <= 32'd0;
        short_stable       <= 32'd0;
        lines_s0           <= 16'd0;
        lines_s1           <= 16'd0;
        lines_stable       <= 16'd0;
        frames_s0          <= 32'd0;
        frames_s1          <= 32'd0;
        frames_stable      <= 32'd0;
        und_s0             <= 32'd0;
        und_s1             <= 32'd0;
        und_stable         <= 32'd0;
        shown_s0           <= 32'd0;
        shown_s1           <= 32'd0;
        shown_stable       <= 32'd0;
    end else begin
        scan_blanking_meta <= vid_blanking;
        scan_blanking      <= scan_blanking_meta;

        // one bit: a plain two-flop chain
        scan_short_meta    <= vid_short;
        scan_short         <= scan_short_meta;

        // 32 bits: stable-sample. Shift the pixel-domain value through two
        // registers and accept it only when both hold the same thing. A count
        // that has stopped changing is not mid-transition, so what software
        // reads was a real value at some point -- not a mixture of two.
        short_s0           <= vid_short_count;
        short_s1           <= short_s0;
        if (short_s0 == short_s1) short_stable <= short_s0;

        // Same scheme for the self-proof counters.
        lines_s0           <= vid_lines_last;
        lines_s1           <= lines_s0;
        if (lines_s0 == lines_s1) lines_stable <= lines_s0;

        frames_s0          <= vid_frames;
        frames_s1          <= frames_s0;
        if (frames_s0 == frames_s1) frames_stable <= frames_s0;

        // 2026-10-27: the two new pixel-domain counters, same stable-sample.
        und_s0             <= vid_underruns;
        und_s1             <= und_s0;
        if (und_s0 == und_s1) und_stable <= und_s0;

        shown_s0           <= vid_shown;
        shown_s1           <= shown_s0;
        if (shown_s0 == shown_s1) shown_stable <= shown_s0;
    end
end

