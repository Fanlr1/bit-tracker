  // ==========================================================================
  // IN-FLIGHT READ COUNTERS (2026-10-17, docs/90 判据 A)
  //
  // If AR completions and R-burst completions drift apart -- one extra R, or an AR
  // whose data never comes -- the info FIFO that routes the R bus falls out of step
  // and every later read waits. That is the working hypothesis for the slow state.
  //
  // 判据 B from docs/90 (compare the FIFO channel against M_R_Id) is UNMEASURABLE
  // here: ID_MODE_SEL is Normal, so MASTER_ID_WIDTH == SLAVE_ID_WIDTH and M_R_Id
  // carries no channel number at all.
  //
  // What IS measurable is the bookkeeping: count AR handshakes and RLAST handshakes.
  // In steady state the difference is the reads in flight, a small constant. A
  // sticky flag latches if it ever exceeds INFLIGHT_MAX, which would mean the two
  // sides are not tracking each other.
  // ==========================================================================
  localparam [31:0] INFLIGHT_MAX = 32'd16;
  reg [31:0] ar_done_cnt, rlast_done_cnt;
  reg        inflight_hi;
  always @(posedge user_clk or negedge sys_rst) begin
      if (!sys_rst) begin
          ar_done_cnt    <= 32'd0;
          rlast_done_cnt <= 32'd0;
          inflight_hi    <= 1'b0;
      end else begin
          if (s_axi_arvalid && s_axi_arready)              ar_done_cnt    <= ar_done_cnt    + 32'd1;
          if (s_axi_rvalid && s_axi_rready && s_axi_rlast) rlast_done_cnt <= rlast_done_cnt + 32'd1;
          if ((ar_done_cnt - rlast_done_cnt) > INFLIGHT_MAX) inflight_hi   <= 1'b1;
      end
  end
