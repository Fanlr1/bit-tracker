// ---- scan-out blanking, synchronised from the pixel domain ----
// o_blanking is generated in the pclk domain. Registers live in the clk domain,
// so it crosses. It is ONE BIT, which is why two flops are enough: a multi-bit
// value would need Gray coding or a handshake to avoid reading a torn word,
// and software does not need a line number -- it needs to know whether it may
// write FB_CFG right now.
wire              vid_blanking;          // pclk domain, from video_out
reg               scan_blanking_meta;
reg               scan_blanking;         // clk domain, safe to expose

// ---- scan-out starvation, synchronised from the pixel domain ----
// Two different crossings, because the two signals have different widths:
//
//   sticky : ONE bit. Two flops are genuinely sufficient.
//   count  : EIGHT bits. Two flops are NOT sufficient -- the bits would cross
//            on independent flops and software could read a value that was
//            never true (0x7F becoming 0x80 through 0xFF, for instance). It is
//            sampled by waiting for the value to be unchanged across
//            consecutive clk edges, which needs no handshake and cannot produce
//            a torn reading: a value that has stopped moving is a real value.
wire             vid_short;              // pclk domain
wire [7:0]       vid_short_count;        // pclk domain
reg              scan_short_meta;
reg              scan_short;             // clk domain
