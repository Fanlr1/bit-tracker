assign sys_rst       = pll_locked & user_pll_locked;

// ==== SoC POWER-ON RESET (added 2026-10-12) =================================
// The Sapphire SoC derives its internal system reset (systemCd_logic_outputReset)
// from io_asyncReset, passed through an async-assert / sync-deassert cell. That
// cell needs a *falling edge* on io_asyncReset to emit a reset pulse.
//
// io_asyncReset used to be wired straight to !pll_locked. If the PLLs are
// already locked by the time the FPGA finishes configuring, that signal is 0
// from the very first clock and the pulse never happens -- so every peripheral
// register keeps its power-up value.
//
// Measured symptom (2026-10-12): UART CLOCK_DIVIDER read back 0x00000000 even
// though soc.v programs 0x0000006B on reset, and no APB peripheral could be
// written (UART / SPI / GPIO / CLINT all read back 0, while RAM writes were
// perfect). Holding io_asyncReset high for 65536 user_clk cycles after
// configuration guarantees the SoC always sees one clean reset pulse.
reg [15:0] soc_por_cnt = 16'h0000;

always @(posedge user_clk) begin
    if (soc_por_cnt != 16'hFFFF)
        soc_por_cnt <= soc_por_cnt + 16'd1;
end

wire soc_por_done  = (soc_por_cnt == 16'hFFFF);
wire soc_async_rst = ~(soc_por_done & pll_locked & user_pll_locked);

// ==== DIAGNOSTIC LED (added 2026-10-12) =====================================
// Clock/reset health onto the four unused board LEDs (LED4..LED7).
// Read it as:  LED7=pll_locked  LED6=user_pll_locked  LED5=sys_rst  LED4=ddr_rstn
// All four must be steadily ON (1) in a healthy design. A blinking or dark LED
// means that clock/reset is unstable -> nothing downstream can ever run.
assign dbg_led = { pll_locked, user_pll_locked, sys_rst, ddr_rstn };

